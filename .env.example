# Copy this file to `.env` and fill in your API keys.
# DO NOT commit `.env` to git — it's in .gitignore.

# Deepgram — https://console.deepgram.com (Settings → API Keys)
DEEPGRAM_API_KEY=

# Sarvam AI — https://www.sarvam.ai (Dashboard → API Keys)
SARVAM_API_KEY=

# ElevenLabs — https://elevenlabs.io (Profile → API Key)
ELEVENLABS_API_KEY=
